{
  "id": "transit",
  "name": "Transit",
  "version": "1.0.0",
  "description": "Display public transit travel times using Google Routes API",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--transit",
  "documentation": "README.md",
  "icon": "train-front",
  "category": "transit",
  "min_refresh_seconds": 60,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Transit",
        "default": false
      },
      "api_key": {
        "type": "string",
        "title": "Google Routes API Key",
        "description": "API key with Routes API enabled",
        "ui:widget": "password"
      },
      "routes": {
        "type": "array",
        "title": "Routes",
        "description": "Transit routes to monitor (max 4)",
        "maxItems": 4,
        "items": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "title": "Origin",
              "description": "Starting address or coordinates"
            },
            "destination": {
              "type": "string",
              "title": "Destination",
              "description": "Ending address or coordinates"
            },
            "destination_name": {
              "type": "string",
              "title": "Display Name",
              "description": "Short name (e.g., WORK, HOME)",
              "maxLength": 10
            }
          },
          "required": [
            "origin",
            "destination",
            "destination_name"
          ]
        }
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "default": 300,
        "minimum": 60
      }
    },
    "required": [
      "api_key",
      "routes"
    ]
  },
  "env_vars": [
    {
      "name": "GOOGLE_ROUTES_API_KEY",
      "required": true,
      "description": "Google Cloud API key with Routes API enabled"
    },
    {
      "name": "TRANSIT_ORIGIN",
      "required": false,
      "description": "Default origin address"
    },
    {
      "name": "TRANSIT_DESTINATION",
      "required": false,
      "description": "Default destination address"
    },
    {
      "name": "TRANSIT_DESTINATION_NAME",
      "required": false,
      "description": "Display name for destination",
      "default": "DOWNTOWN"
    }
  ],
  "variables": {
    "groups": {
      "commute": {
        "label": "Transit Data"
      },
      "display": {
        "label": "Display"
      }
    },
    "simple": {
      "duration_minutes": {
        "description": "Transit trip duration in minutes for first route",
        "type": "number",
        "max_length": 3,
        "group": "commute",
        "example": "32"
      },
      "destination_name": {
        "description": "Display name for the route destination",
        "type": "string",
        "max_length": 10,
        "group": "commute",
        "example": "WORK"
      },
      "formatted": {
        "description": "Pre-formatted transit summary",
        "type": "string",
        "max_length": 22,
        "group": "display",
        "example": "WORK: 32m"
      },
      "route_count": {
        "description": "Number of monitored routes",
        "type": "number",
        "max_length": 1,
        "group": "display",
        "example": "2"
      },
      "longest_duration": {
        "description": "Longest trip duration across all routes in minutes",
        "type": "number",
        "max_length": 3,
        "group": "commute",
        "example": "47"
      }
    },
    "arrays": {
      "routes": {
        "label_field": "destination_name",
        "item_fields": [
          "duration_minutes",
          "destination_name",
          "formatted"
        ]
      }
    }
  },
  "max_lengths": {
    "routes.*.duration_minutes": 3,
    "routes.*.destination_name": 10,
    "routes.*.formatted": 22
  },
  "fiestaboard_version": ">=2.10.0",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Transit times displayed on a Vestaboard",
      "caption": "Display public transit travel times using Google Routes API",
      "primary": true
    }
  ],
  "teaser": "UNION STN 32 MIN",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}",
        "   TRANSIT TIMES",
        "",
        " UNION STN     32 MIN",
        " AIRPORT       47 MIN",
        "{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{67}{67} TRANSIT",
        "UNION STN",
        "32 MIN"
      ]
    }
  ],
  "demo": {
    "flagship": {
      "name": "Transit Demo",
      "template": [
        "Transit Times",
        "{{transit.destination_name}}",
        "{{transit.duration_minutes}} min",
        "{{transit.routes.1.formatted}}",
        "{{transit.route_count}} routes",
        "{{transit.formatted}}"
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "Transit (Note)",
      "template": [
        "{{transit.destination_name}}",
        "{{transit.duration_minutes}} MIN",
        "{{transit.routes.1.formatted}}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
